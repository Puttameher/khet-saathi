# Copy to .env (gitignored). Never commit real keys.

# Gnani Speech APIs (Prisma STT + Timbre TTS). Server-side only.
GNANI_API_KEY=your-gnani-api-key-here
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0

# LLM (any OpenAI-compatible endpoint; Groq by default). Server-side only.
LLM_API_KEY=your-llm-api-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Monitoring schedule (IST, comma separated HH:MM)
MONITOR_TIMES=06:00,12:00,18:00
# Set to 0 to disable the in-process scheduler (e.g. serverless deploys)
SCHEDULER_ENABLED=1

# SQLite file
KS_DB_PATH=./data/khet-saathi.db

# Demo Mode: scripted weather scenarios for the demo video ONLY. Visibly badged in the UI.
DEMO_MODE=0
